# ============================================================================
# RCGM — Local development environment configuration
# Copy this file to .env and adjust values as needed.
# NEVER commit a real .env file with production secrets.
# ============================================================================

# ---- PostgreSQL (used by the bundled docker-compose "postgres" service) ----
POSTGRES_USER=rcgm
POSTGRES_PASSWORD=rcgm_dev_password_change_me
POSTGRES_DB=rcgm
# Host-side port mapping only (container always listens on 5432 internally).
# Default is 5434 (not 5432/5433) to avoid clashing with any other local
# Postgres instance you may already have running.
POSTGRES_PORT=5434

# Full connection string used by the FastAPI backend (SQLAlchemy + Alembic)
# when running OUTSIDE Docker (e.g. `uvicorn` directly on the host) or when
# pointing at an external Postgres instance instead of the bundled service.
# When running via `docker compose up`, the "api" service builds its own
# DATABASE_URL from the POSTGRES_* variables above against the internal
# "postgres:5432" hostname — this value is only used for host-side tooling
# (Alembic run locally, psql, etc.).
DATABASE_URL=postgresql+psycopg://rcgm:rcgm_dev_password_change_me@localhost:5434/rcgm

# ---- Backend (FastAPI) ----
# Default is 8010 (not 8000) — this VPS already has another service (Coolify)
# bound to host port 8000. Change freely if 8010 is also taken locally.
API_PORT=8010
ENVIRONMENT=development
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_dev_only_insecure_secret_key
SESSION_COOKIE_NAME=rcgm_session
SESSION_TTL_MINUTES=480
SESSION_ABSOLUTE_TTL_HOURS=24
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:3011
UPLOAD_STORAGE_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=10
BACKEND_INTERNAL_URL=http://api:8000

# ---- Frontend (Next.js) ----
# Default is 3011 (not 3000) — this VPS already has another app bound to host
# port 3000. Change freely if 3011 is also taken locally.
WEB_PORT=3011
NEXT_PUBLIC_APP_NAME=RCGM
# Server-side (container-to-container) API base used by the Next.js proxy route.
API_BASE_URL=http://api:8000

# ---- Seed data ----
SEED_TENANT_CODE=JDL
SEED_TENANT_NAME=Jims Diamond Lounge
SEED_DEMO_PASSWORD_SUFFIX=123
